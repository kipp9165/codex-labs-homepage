# codex-labs-homepage — environment variables
#
# Root-level variables used by scripts/ and src/ (not the webhook server).
# Copy this file to .env for local development.
# Production values are set in the Render dashboard — do NOT commit secrets.

# ---------------------------------------------------------------------------
# Analytics
# ---------------------------------------------------------------------------

# Plausible API key (used by analytics scripts, not the browser snippet).
PLAUSIBLE_API_KEY=

# Plausible site ID — must match data-domain in HTML Plausible snippets.
PLAUSIBLE_SITE_ID=codex-labs-homepage-4.onrender.com

# ---------------------------------------------------------------------------
# Affiliate program
# ---------------------------------------------------------------------------

# Public URL of the affiliate signup form. Injected into affiliate.html by
# the checkout-links.js runtime if window.__AFFILIATE_SIGNUP_URL is set.
# Leave blank to fall back to the mailto: link already in the HTML.
AFFILIATE_SIGNUP_URL=

# ---------------------------------------------------------------------------
# Fulfillment / license generation
# ---------------------------------------------------------------------------

# Stripe secret key for Whale Tier entitlement checks.
# Set this directly in Render with no quotes, trailing spaces, or newlines.
STRIPE_SECRET_KEY=

# HMAC signing secret for license tokens. Defaults to a dev constant if unset.
LICENSE_SECRET=

# ---------------------------------------------------------------------------
# Local dev server
# ---------------------------------------------------------------------------

# Port for the static file server (npm run dev / start).
PORT=3000
